LLM_MAX_RUNS_PER_MIN=8
LLM_FAKE=false
CONF_HIGH=0.75
CONF_BLOCK=0.5
SLA_SWEEP_SECONDS=30
MAIL_PROVIDER=mock
SMTP_HOST=
