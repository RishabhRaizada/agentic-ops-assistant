APP_ENV=dev
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./data/opspilot.db
APP_TIMEZONE=Asia/Kolkata
COOKIE_SECURE=false
GOOGLE_API_KEY=
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite
